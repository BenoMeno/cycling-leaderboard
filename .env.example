# ─────────────────────────────────────────────────────
#  Cycling Leaderboard — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# The URL where this app is running.
# Local dev:  http://localhost:3000
# Production: https://yourdomain.com
BASE_URL=http://localhost:3000

# Port to run on (default: 3000)
PORT=3000

# A secret word for Strava webhook verification (can be anything)
WEBHOOK_VERIFY_TOKEN=cycling-challenge
