# ─────────────────────────────────────────────────────
#  Cycling Leaderboard — Environment Variables
# ─────────────────────────────────────────────────────

# Turso database
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your-turso-auth-token

# Strava API (from strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# The public URL of this app (no trailing slash)
BASE_URL=https://cycling.yourdomain.com

# Admin page password
ADMIN_PASSWORD=choose-a-strong-password

# Port (default 3000)
PORT=3000
