# ─────────────────────────────────────────────────────
#  Cycling Leaderboard — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────

# From https://app.turso.tech → your database → Connect
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your-turso-auth-token

# Admin page password — choose anything strong
ADMIN_PASSWORD=choose-a-strong-password-here

# Port to run on (default: 3000)
PORT=3000
